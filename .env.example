# Copie para .env e preencha. NUNCA commite o .env com valores reais.

# ── Banco ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://dexo:dexo@localhost:5434/dexo"
DIRECT_URL="postgresql://dexo:dexo@localhost:5434/dexo"

# ── Auth / URLs ───────────────────────────────────────────────────
NEXTAUTH_SECRET="troque-por-um-segredo-de-ao-menos-16-chars"
NEXTAUTH_URL="http://localhost:3000"
APP_BACKEND_URL="http://localhost:3333"
NEXT_PUBLIC_API_URL="http://localhost:3333"

# ── Mercado Livre ─────────────────────────────────────────────────
ML_CLIENT_ID="seu_ml_client_id"
ML_CLIENT_SECRET="seu_ml_client_secret"
ML_AUTH_URL="https://auth.mercadolivre.com.br"
ML_API_URL="https://api.mercadolibre.com"
ML_REDIRECT_URI="http://localhost:3000/integracoes/mercado-livre/callback"

# ── Shopee ────────────────────────────────────────────────────────
SHOPEE_PARTNER_ID="seu_partner_id"
SHOPEE_PARTNER_KEY="sua_partner_key"
SHOPEE_REDIRECT_URI="http://localhost:3000/integracoes/shopee/callback"

# ── Magalu ────────────────────────────────────────────────────────
MAGALU_CLIENT_ID="seu_magalu_client_id"
MAGALU_CLIENT_SECRET="seu_magalu_client_secret"
MAGALU_REDIRECT_URI="http://localhost:3000/integracoes/magalu/callback"

# ── OLX (autoupload / anúncios) ───────────────────────────────────
# Credenciais vêm por email de suporteintegrador@olxbr.com (sem portal
# self-service). A OLX só aceita o redirect de PRODUÇÃO registrado; localhost
# é rejeitado. Integração fica atrás da flag abaixo.
NEXT_PUBLIC_OLX_INTEGRATION_ENABLED="false"
OLX_CLIENT_ID="seu_olx_client_id"
OLX_CLIENT_SECRET="seu_olx_client_secret"
OLX_REDIRECT_URI="https://usedexo.com.br/integracoes/olx/callback"
# Escopos OAuth (separados por espaço). Vazio → default das constantes.
# OLX_SCOPES="basic_user_info autoupload"
# Contato do vendedor EXIGIDO em cada anúncio (a OLX não deriva do produto):
OLX_SELLER_PHONE="21999999999"   # DDD + número (10-11 dígitos)
OLX_SELLER_ZIPCODE="20000000"    # CEP (só dígitos)
