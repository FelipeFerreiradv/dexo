# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

#prisma
prisma/migrations/
/app/generated/prisma

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fiscal runtime storage (XMLs assinados e DANFE PDFs)
.fiscal-storage/

# cópias canônicas de planilhas de importação (grandes, reproduzíveis)
scripts/data/

# relatórios/saídas dos scripts (JSON/XLSX reproduzíveis, contêm dados de produto)
scripts/out/

# scripts de diagnóstico/scratch (análises pontuais, não fazem parte do toolset)
scripts/_tmp-*

