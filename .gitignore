# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage

# next.js
/.next/
/out/

# build id (gerado por build em scripts/generate-build-id.mjs; lido pelo
# next.config e por /api/version — regenerado a cada build, não versionar)
.build-id

# production
/build

# misc
.DS_Store
# Certificados/segredos: nunca versionar (cert A1 .pfx/.p12, chaves, etc.)
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.der

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...exceto o template de documentacao (sem segredos): variaveis do RT da NF-e.
!.env.example

#prisma
/app/generated/prisma

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fiscal runtime storage (XMLs assinados e DANFE PDFs)
.fiscal-storage/

# whatsapp runtime storage (mídia recebida — privada, servida por rota autenticada)
.whatsapp-storage/

# cópias canônicas de planilhas de importação (grandes, reproduzíveis)
scripts/data/

# relatórios/saídas dos scripts (JSON/XLSX reproduzíveis, contêm dados de produto)
scripts/out/

# scripts de diagnóstico/scratch (análises pontuais, não fazem parte do toolset)
scripts/_tmp-*

# runtime cache (shopee category attrs, etc) — populado em prod, não versionado
.cache/

__pycache__/
