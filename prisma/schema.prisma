generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String   @id @default(cuid())
  name                      String?
  email                     String   @unique
  password                  String
  avatarUrl                 String?
  role                      Role     @default(USER)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  defaultProductDescription String?
  defaultCostPrice          Decimal? @db.Decimal(10, 2)
  defaultStock              Int?     @default(0)

  // Padrões de anúncio ML (preferências do usuário)
  defaultListingType       String? // "bronze" | "gold_special" | "gold_pro"
  defaultHasWarranty       Boolean? @default(false)
  defaultWarrantyUnit      String? // "dias" | "meses"
  defaultWarrantyDuration  Int?
  defaultItemCondition     String? // "new" | "used"
  defaultShippingMode      String? // "me2" | "me1" | "custom" | "not_specified"
  defaultFreeShipping      Boolean? @default(false)
  defaultLocalPickup       Boolean? @default(false)
  defaultManufacturingTime Int?     @default(0)

  // Aumento percentual escalonado de preço entre contas ML (anti-penalização
  // por anúncios idênticos). Valor padrão usado para pré-preencher o toggle no
  // wizard de anúncio em massa; 0 = desativado. Ver cross-account-price.service.
  crossAccountPriceIncreasePercent Decimal? @default(0) @db.Decimal(5, 2)

  // Contador do último SKU sequencial gerado pelo modal "Novo Produto".
  // Importações de estoque escrevem direto em Product e NÃO tocam aqui —
  // por isso o contador reflete só a sequência humana, sem contaminação
  // de códigos externos de fornecedor (códigos de barra etc).
  lastSkuSequential Int?

  // Acesso ao sistema. true = liberado (default), false = BLOQUEADO (ex.: falta
  // de pagamento). Bloquear NÃO apaga dados — é um "soft disable" reversível.
  // Default true => migração não bloqueia ninguém (zero regressão).
  isActive Boolean @default(true)

  // Gate do módulo WhatsApp (plano pago superior). NULL = sem acesso (estado de
  // todos os usuários existentes — zero regressão); timestamp = habilitado.
  // Colaboradores herdam do admin pai (a checagem usa sempre o dataOwnerId).
  whatsappEnabledAt DateTime?

  // Permissões de acesso por página (colaboradores). Mapa { [pageId]: boolean }.
  // NULL/ausente = acesso a TUDO (default → zero regressão); pageId=false =
  // bloqueado. Só afeta colaboradores; admin/superadmin sempre têm acesso total.
  // Migração: ALTER TABLE "User" ADD COLUMN "pagePermissions" JSONB;
  pagePermissions Json?

  // Hierarquia administrador → colaboradores (additive, default NULL).
  // Para usuários sem parentUserId, comportamento é idêntico ao anterior.
  parentUserId String?
  parent       User?   @relation("UserHierarchy", fields: [parentUserId], references: [id], onDelete: SetNull)
  children     User[]  @relation("UserHierarchy")

  accounts            MarketplaceAccount[]
  products            Product[]
  productsCreated     Product[]           @relation("ProductCreatedBy")
  listingsCreated     ProductListing[]    @relation("ListingCreatedBy")
  systemLogs          SystemLog[]
  locations           Location[]
  scraps              Scrap[]
  customers           Customer[]
  payables            Payable[]
  receivables         Receivable[]
  budgets             Budget[]            @relation("BudgetOwner")
  budgetsAsVendedor   Budget[]            @relation("BudgetVendedor")
  companyFiscalConfigs CompanyFiscalConfig[]
  nfesEmitidas         NfeEmitida[]
  bulkListingJobs     BulkListingJob[]
  unidades            Unidade[]
  whatsAppAccounts    WhatsAppAccount[]

  @@index([parentUserId])
}

model Product {
  id                     String                 @id @default(cuid())
  sku                    String
  skuNormalized          String?
  name                   String
  description            String?
  price                  Decimal                @db.Decimal(10, 2)
  stock                  Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  costPrice              Decimal?               @db.Decimal(10, 2)
  markup                 Decimal?               @db.Decimal(10, 2)
  brand                  String?
  model                  String?
  year                   String?
  version                String?
  category               String?
  location               String?
  partNumber             String?
  partNumberNormalized   String?
  quality                Quality?
  isSecurityItem         Boolean                @default(false)
  isTraceable            Boolean                @default(false)
  sourceVehicle          String?
  imageUrl               String?
  imageUrls              String[]               @default([])
  mlCategoryId           String?
  heightCm               Int?
  lengthCm               Int?
  weightKg               Decimal?               @db.Decimal(6, 2)
  widthCm                Int?
  userId                 String?
  // Autor real do cadastro (request.user.id — colaborador ou admin que agiu),
  // distinto de `userId` (dono/tenant = dataOwnerId). NULL = registro legado ou
  // fluxo de sistema (import/autodetect/scripts) → UI exibe "—".
  // Sem FK física no banco (decisão): Prisma resolve o include sem constraint e
  // id órfão (colaborador excluído) vira relação null → "—".
  // Migração: ALTER TABLE "Product" ADD COLUMN IF NOT EXISTS "createdByUserId" TEXT;
  createdByUserId        String?
  mlCategorySource       String?
  mlCategoryChosenAt     DateTime?
  shopeeCategoryId       String?
  shopeeCategorySource   String?
  shopeeCategoryChosenAt DateTime?
  // Categoria Magalu (uuid da taxonomia da API — não há árvore local).
  magaluCategoryId       String?
  magaluCategorySource   String?
  magaluCategoryChosenAt DateTime?
  locationId             String?
  scrapId                String?
  attributes             Json?
  mlCatalogProductId     String?
  mlCatalogSnapshot      Json?
  // Posição das compatibilidades no ML (["Dianteira","Esquerda"]). Uma posição
  // por produto, aplicada a todos os veículos compatíveis — por isso mora aqui
  // e não na ProductCompatibility.
  compatibilityPositions Json?
  createdFromMarketplace Boolean                @default(false)
  // Bloco F — peça avulsa do PDV promovida a produto. Nasce e morre com
  // estoque 0 na mesma operação, então NÃO conta como catálogo na
  // reconciliação de status da sucata (ver ScrapStatusReconcileService):
  // sem este filtro, um lote vendido só no balcão viraria DEPLETED.
  // DEFAULT FALSE em 100% das linhas existentes => reconcile byte-idêntico.
  autoCreatedFromSale    Boolean                @default(false)
  originPlatform         Platform?
  orderItems             OrderItem[]
  compatibilities        ProductCompatibility[]
  mlCategory             MarketplaceCategory?   @relation("ProductMlCategory", fields: [mlCategoryId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  createdBy              User?                  @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])
  productLocation        Location?              @relation(fields: [locationId], references: [id])
  scrap                  Scrap?                 @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listings               ProductListing[]
  stockLogs              StockLog[]
  nfeItens               NfeItem[]
  receivableItems        ReceivableItem[]
  budgetItems            BudgetItem[]

  @@unique([userId, sku])
  @@index([userId, skuNormalized])
  @@index([userId, partNumberNormalized])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([sku])
  @@index([locationId])
  @@index([scrapId])
  @@index([mlCatalogProductId])
}

model ProductCompatibility {
  id        String   @id @default(cuid())
  productId String
  brand     String
  model     String
  yearFrom  Int?
  yearTo    Int?
  version   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Estatísticas agregadas (determinísticas) dos produtos vivos de TODOS os
// usuários, recalculadas por um job noturno (scripts/build-catalog-stats.ts).
// Alimenta a "sugestão da base interna" no cadastro de produto. Contém SOMENTE
// agregados (mediana/moda/união/contagem) — NUNCA linha individual, userId,
// loja, costPrice ou markup (privacidade/LGPD). Só persiste chaves com
// sampleSize >= 5 (o limiar também é proteção contra expor um único concorrente).
// Tabela 100% reproduzível por execução: upsert por matchKey + prune por computedAt.
model CatalogStat {
  id String @id @default(cuid())

  // Identidade canônica/display: "partType|brand|model|version|yearFrom-yearTo".
  // Usada só para upsert idempotente; os lookups vão pelas colunas indexadas.
  matchKey String @unique

  // Colunas de lookup (normalizadas). Sentinela "*" quando o campo não se aplica
  // (ex.: linha version-agnóstica usa version = "*"). yearFrom/yearTo = faixa
  // min/max dos anos dos membros do grupo; o endpoint casa por interseção.
  partType String
  brand    String @default("*")
  model    String @default("*")
  version  String @default("*")
  yearFrom Int?
  yearTo   Int?

  // Tamanho da amostra. sampleSize = nº de membros do grupo (gate >= 5).
  // priceSampleSize = sobreviventes após corte de outliers IQR (transparência).
  sampleSize      Int
  priceSampleSize Int?

  // Medianas (preço usa SOMENTE `price` — nunca costPrice/markup).
  priceMedian    Decimal? @db.Decimal(10, 2)
  weightKgMedian Decimal? @db.Decimal(6, 2)
  heightCmMedian Int?
  widthCmMedian  Int?
  lengthCmMedian Int?

  // Modas (valor mais frequente + frequência). Só preenchidas quando freq >= 2.
  qualityMode            String?
  qualityModeCount       Int?
  partNumberMode         String?
  partNumberModeCount    Int?
  versionMode            String?
  versionModeCount       Int?
  sourceVehicleMode      String?
  sourceVehicleModeCount Int?
  mlCategoryIdMode       String?
  mlCategoryIdModeCount  Int?
  shopeeCategoryIdMode      String?
  shopeeCategoryIdModeCount Int?

  // Ficha técnica: { [attrId]: { value_id?, value_name?, freq } } (valor mais
  // frequente por chave de atributo). Compatibilidades: união deduplicada,
  // ranqueada por frequência: [{ brand, model, yearFrom, yearTo, version, freq }].
  attributes      Json?
  compatibilities Json?

  // Carimbo da execução do job; base da varredura de prune (deleteMany lt run).
  computedAt DateTime @default(now())

  @@index([partType, brand, model, version, sampleSize])
  @@index([partType, brand, model, version, yearFrom, yearTo])
  @@index([computedAt])
}

model Location {
  id          String     @id @default(cuid())
  userId      String
  code        String
  description String?
  maxCapacity Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  products    Product[]
  scraps      Scrap[]

  @@unique([userId, code])
  @@index([userId])
  @@index([parentId])
}

model MarketplaceAccount {
  id                          String                @id @default(cuid())
  userId                      String
  platform                    Platform
  accountName                 String
  accessToken                 String
  refreshToken                String
  expiresAt                   DateTime
  externalUserId              String?
  status                      AccountStatus         @default(ACTIVE)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  shopId                      Int?
  appClientId                 String?
  appClientSecret             String?
  autoImportListingsSince     DateTime?
  shopeeListingsSyncedThrough DateTime?
  // Marca d'água do poll de PEDIDOS da Shopee: até quando a janela por
  // `update_time` já foi varrida com sucesso. Espelha o campo acima, que faz o
  // mesmo para anúncios. NULL = nunca varrido; cai na janela por dias, que é o
  // comportamento anterior. Só avança quando o ciclo termina sem erro — assim
  // um ciclo que falhou no meio é refeito em vez de pular pedidos.
  // Migração: ALTER TABLE "MarketplaceAccount" ADD COLUMN IF NOT EXISTS "shopeeOrdersSyncedThrough" TIMESTAMP(3);
  shopeeOrdersSyncedThrough   DateTime?
  // Multi-CNPJ: CNPJ emissor vinculado a esta conta (CompanyFiscalConfig.id,
  // scalar sem FK — padrão do módulo fiscal). NULL = usa o CNPJ padrão do tenant.
  companyFiscalConfigId       String?
  // Dados de vendedor POR CONTA (multi-tenant). NULL = usa o fallback do .env,
  // então é aditivo e não muda nada para contas existentes. OLX exige telefone/CEP
  // do vendedor em cada anúncio; Facebook precisa do catálogo e da URL base do item.
  olxSellerPhone              String?
  olxSellerZipcode            String?
  fbCatalogId                 String?
  fbProductUrlBase            String?
  user                        User                  @relation(fields: [userId], references: [id])
  orders                      Order[]
  listings                    ProductListing[]
  syncLogs                    SyncLog[]
  questions                   MarketplaceQuestion[]
  ingestionIssues             OrderIngestionIssue[]

  @@unique([platform, externalUserId])
  @@unique([platform, shopId])
  @@index([userId])
  @@index([companyFiscalConfigId])
}

/// Quarentena de pedido de marketplace que NÃO pôde ser totalmente ingerido.
///
/// Antes deste modelo, um pedido cujos itens não casassem com nenhum produto
/// morria num `continue` mudo (order.usercase): não virava Order, não gerava
/// SystemLog, não aparecia em /pedidos, e o SyncLog do ciclo era gravado como
/// SUCCESS. O cliente só descobria contando o estoque físico. Os logs de
/// produção de 29/07/2026 mostram isso acontecendo agora ("Produto com SKU
/// TRL-296 (Shopee) não encontrado", e mais oito casos no mesmo ciclo).
///
/// A regra que este modelo materializa: para todo pedido que a API do
/// marketplace devolveu, ao fim da ingestão existe um `Order` OU um
/// `OrderIngestionIssue` aberto. Nunca nenhum dos dois.
///
/// Migração:
///   CREATE TABLE IF NOT EXISTS "OrderIngestionIssue" (...);
///   CREATE UNIQUE INDEX IF NOT EXISTS "OrderIngestionIssue_marketplaceAccountId_externalOrderId_key" ...;
/// (SQL completo em prisma/migrations/20260729130000_add_order_ingestion_issue/)
model OrderIngestionIssue {
  id                   String   @id @default(cuid())
  marketplaceAccountId String
  platform             Platform
  externalOrderId      String
  /// Detalhe do pedido vindo da API, PODADO: só os campos que a reingestão
  /// precisa. Nunca guarda token, e nenhum dado do comprador além do que o
  /// Order já persiste hoje (buyer_username / nome).
  payload              Json?
  /// NO_LINKED_ITEMS | PARTIAL_LINK | PRODUCT_NOT_FOUND | ITEM_WITHOUT_SKU
  /// | STOCK_DEDUCTION_FAILED | FETCH_FAILED | UNKNOWN_STATUS | INGEST_FAILED
  reason               String
  detail               String?
  /// OPEN | NEEDS_ACTION | RESOLVED. Nunca existe estado terminal de falha nem
  /// estado terminal SILENCIOSO. O que o reconciliador não resolve em 5
  /// tentativas vira NEEDS_ACTION: sai da fila automática (runOnce filtra OPEN),
  /// mas continua visível na aba de Pendências e continua sendo completado pelo
  /// poll quando o cliente cadastra o produto. Nada vira FAILED e some de vista.
  status               String   @default("OPEN")
  attempts             Int      @default(0)
  nextRetryAt          DateTime @default(now())
  resolvedOrderId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  /// Reentrega/re-poll ATUALIZA o registro, não duplica.
  @@unique([marketplaceAccountId, externalOrderId])
  @@index([status, nextRetryAt])
  @@index([marketplaceAccountId, status])
}

model ProductListing {
  id                   String    @id @default(cuid())
  productId            String
  marketplaceAccountId String
  externalListingId    String
  externalSku          String?
  status               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  permalink            String?
  lastError            String?
  nextRetryAt          DateTime?
  retryAttempts        Int       @default(0)
  retryEnabled         Boolean   @default(false)
  requestedCategoryId  String?
  metricsUpdatedAt     DateTime?
  ratingAverage        Decimal?  @db.Decimal(3, 2)
  reviewsCount         Int       @default(0)
  viewsCount           Int       @default(0)
  listingType          String?
  itemCondition        String?
  hasWarranty          Boolean?
  warrantyUnit         String?
  warrantyDuration     Int?
  shippingMode         String?
  freeShipping         Boolean?
  localPickup          Boolean?
  manufacturingTime    Int?

  // Autor real da criação do anúncio (actorId do dispatcher = request.user.id).
  // NULL = legado ou fluxo de sistema (autodetect/sync/retry) → UI exibe "—".
  // Sem FK física no banco — mesma decisão do Product.createdByUserId.
  // Migração: ALTER TABLE "ProductListing" ADD COLUMN IF NOT EXISTS "createdByUserId" TEXT;
  createdByUserId      String?

  // Diagnóstico do envio de compatibilidade veicular ao marketplace.
  // O ML responde HTTP 200 mesmo quando ignora os veículos (`ids: []`), então
  // "enviado" nunca foi sinônimo de "gravado". Aqui fica o que o read-back
  // encontrou de fato, para o vendedor ver na aplicação em vez de descobrir
  // semanas depois no painel do ML.
  // NÃO usar `lastError` para isto: aquele campo é o canal de retry (prefixo
  // [TERMINAL]) e é zerado a cada sucesso de sync, o que apagaria o aviso.
  // Migração: ALTER TABLE "ProductListing"
  //   ADD COLUMN IF NOT EXISTS "compatSyncedAt" TIMESTAMP(3),
  //   ADD COLUMN IF NOT EXISTS "compatDiagnostics" JSONB;
  compatSyncedAt       DateTime?
  compatDiagnostics    Json?

  // OLX autoupload: `list_id` é o id REAL do anúncio na OLX (≠ externalListingId,
  // que guardamos como o SKU/`id` estável enviado no ad_list). Devolvido só na
  // consulta de status quando status="accepted". A `url`/permalink vai em
  // `permalink`. Só populado para listings da plataforma OLX.
  olxListId            String?

  // Facebook/Meta Commerce Catalog: id numérico do item no catálogo (devolvido
  // no items_batch). O `retailer_id` enviado ao catálogo = o SKU, guardado em
  // `externalListingId`; o permalink (quando houver) vai em `permalink`. Só
  // populado para listings da plataforma FACEBOOK.
  fbCatalogItemId      String?

  // Override fields: quando preenchidos, sobrescrevem o valor do produto
  // PARA ESTE ANÚNCIO ESPECÍFICO. NULL = herda do produto.
  // Estoque NÃO tem override por design (evita oversell — unidade física é
  // do produto e é replicada para todos os anúncios pelo SyncService).
  titleOverride           String?
  descriptionOverride     String?
  priceOverride           Decimal? @db.Decimal(10, 2)
  brandOverride           String?
  modelOverride           String?
  yearOverride            String?
  versionOverride         String?
  categoryOverride        String?
  mlCategoryOverride      String?
  shopeeCategoryOverride  String?
  olxCategoryOverride     String?
  fbCategoryOverride      String?
  partNumberOverride      String?
  qualityOverride         String?
  heightCmOverride        Int?
  widthCmOverride         Int?
  lengthCmOverride        Int?
  weightKgOverride        Float?
  imageUrlsOverride       Json?
  attributesOverride      Json?
  compatibilitiesOverride Json?
  sourceVehicleOverride   String?

  orderItems         OrderItem[]
  marketplaceAccount MarketplaceAccount    @relation(fields: [marketplaceAccountId], references: [id])
  product            Product               @relation(fields: [productId], references: [id])
  createdBy          User?                 @relation("ListingCreatedBy", fields: [createdByUserId], references: [id])
  questions          MarketplaceQuestion[]
  receivableItems    ReceivableItem[]
  budgetItems        BudgetItem[]

  @@unique([marketplaceAccountId, externalListingId])
  @@index([marketplaceAccountId, metricsUpdatedAt])
  @@index([productId])
  // PERF: serve o findPendingRetries do ListingRetryService (tick 60s) —
  // WHERE retryEnabled=true ORDER BY updatedAt. DDL aplicado manualmente em
  // produção (CREATE INDEX CONCURRENTLY); este @@index é o espelho.
  @@index([retryEnabled, updatedAt])
}

model MarketplaceCategory {
  id               String          @id @default(cuid())
  externalId       String          @unique
  siteId           String
  name             String
  fullPath         String
  pathFromRoot     Json
  parentExternalId String?
  keywords         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  aliases          CategoryAlias[]
  products         Product[]       @relation("ProductMlCategory")

  @@index([siteId])
  @@index([parentExternalId])
}

model CategoryAlias {
  id                    String              @id @default(cuid())
  marketplaceCategoryId String
  tokens                String?
  synonyms              String?
  brandModelPatterns    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  marketplaceCategory   MarketplaceCategory @relation(fields: [marketplaceCategoryId], references: [id])

  @@index([marketplaceCategoryId])
}

model Order {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  externalOrderId      String
  status               OrderStatus        @default(PENDING)
  totalAmount          Decimal            @db.Decimal(10, 2)
  customerName         String?
  customerEmail        String?
  // Cliente do CRM vinculado à venda (auto-cadastro best-effort no import).
  // SetNull preserva o delete de Customer para clientes com pedido vinculado.
  customerId           String?
  // Quando a baixa de estoque deste pedido foi efetivada, gravado DENTRO da
  // mesma transação da baixa. Existe para tornar trivial a pergunta "quais
  // pedidos estão sem baixa?" — antes só dava para responder cruzando StockLog
  // por `reason`, que é texto livre.
  //
  // NÃO é a fonte de verdade da idempotência: quem garante que nada baixa duas
  // vezes continua sendo o NET do StockLog por `reason` determinística (ver
  // processOrderCancellation). Esta coluna é marca de auditoria. Pedidos
  // anteriores à migração ficam NULL — o backfill é script separado.
  // Migração: ALTER TABLE "Order" ADD COLUMN IF NOT EXISTS "stockDeductedAt" TIMESTAMP(3);
  stockDeductedAt      DateTime?
  // Data em que a VENDA aconteceu no marketplace (ML `date_created`, Shopee
  // `create_time`, Magalu `purchased_at`).
  //
  // Existe porque `createdAt` é a hora em que o Dexo IMPORTOU, e Dashboard e
  // Financeiro filtram por ela: o faturamento era atribuído à data do import, não
  // à da compra. Com o ciclo de sync levando até 71,9 h (incidente de 29/07/2026),
  // vendas eram datadas com até 3 dias de atraso, atravessando virada de mês.
  //
  // Pedidos anteriores à migração ficam NULL, e todo filtro usa
  // COALESCE(soldAt, createdAt) — então o histórico continua se comportando
  // exatamente como antes.
  // Migração: ALTER TABLE "Order" ADD COLUMN IF NOT EXISTS "soldAt" TIMESTAMP(3);
  soldAt               DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id])
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  nfesEmitidas         NfeEmitida[]
  shipmentLabel        ShipmentLabel?

  @@unique([marketplaceAccountId, externalOrderId])
  @@index([marketplaceAccountId, createdAt])
  // Migração: CREATE INDEX IF NOT EXISTS "Order_marketplaceAccountId_soldAt_idx" ON "Order"("marketplaceAccountId", "soldAt");
  @@index([marketplaceAccountId, soldAt])
  // ATENÇÃO: existem DOIS índices de EXPRESSÃO que o Prisma não consegue
  // declarar aqui, criados em prisma/migrations/20260730020000_add_order_period_expression_idx:
  //   Order_mktAcc_periodo_idx  ON ("marketplaceAccountId", (COALESCE("soldAt","createdAt")))
  //   Order_periodo_idx         ON ((COALESCE("soldAt","createdAt")))
  // Eles servem o filtro de período do Dashboard e do relatório. Sem eles o
  // predicado fica não-sargável (função sobre coluna indexada) e o planner cai
  // em scan. NÃO remover ao mexer nos índices acima.
  @@index([status, updatedAt])
  @@index([customerId])
}

// Etiqueta de envio (AWB/Mercado Envios) de um pedido. ADITIVO e 1:1 com Order
// (orderId @unique). Order não ganha colunas — só a relação virtual acima, que
// não gera DDL. Persiste o estado do fluxo: NF-e enviada ao marketplace →
// liberação → etiqueta gerada. labelStatus segue NONE|INVOICE_SENT|
// READY_TO_PRINT|GENERATED|ERROR. provider = "MERCADO_LIVRE" | "SHOPEE".
model ShipmentLabel {
  id             String    @id @default(cuid())
  orderId        String    @unique
  provider       String
  shipmentId     String?
  trackingNumber String?
  labelStatus    String    @default("NONE")
  labelSize      String?
  labelPdfPath   String?
  labelError     String?
  invoiceSentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  listingId String?
  listing   ProductListing? @relation(fields: [listingId], references: [id])
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])

  @@index([listingId])
  @@index([orderId])
  @@index([productId])
}

model StockLog {
  id            String   @id @default(cuid())
  productId     String
  change        Int
  reason        String
  previousStock Int
  newStock      Int
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([productId, createdAt])
  // PERF: serve o StockReconciliationService (tick 15min) — WHERE
  // createdAt >= now()-1h numa tabela append-only que só cresce (era seq
  // scan). DDL manual em produção; este @@index é o espelho.
  @@index([createdAt])
}

model StockSyncJob {
  id          String   @id @default(cuid())
  productId   String
  listingId   String
  platform    Platform
  targetStock Int
  attempts    Int      @default(0)
  nextRunAt   DateTime @default(now())
  status      String   @default("PENDING")
  lastError   String?
  orderId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([listingId, status])
  @@index([status, nextRunAt])
  @@index([productId])
}

// Job durável do RECORTE ASSÍNCRONO (PR 4 da remoção universal): o upload
// responde na hora com a WebP otimizada e cria este job; o worker in-process
// (ImageBgWorkerService) processa o recorte SEM orçamento de request e, ao
// concluir, troca as referências (Product/Scrap/Listing) da WebP pelo PNG.
// DDL manual em produção; ver prisma/migrations/20260730020000_add_image_bg_job.
model ImageBgJob {
  id             String    @id @default(cuid())
  uploadUuid     String    @unique
  origFileName   String
  webpFileName   String
  addShadow      Boolean   @default(false)
  status         String    @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED
  attempts       Int       @default(0)
  nextRunAt      DateTime  @default(now())
  // Lease do claim: PROCESSING com lease vencida volta a PENDING (worker
  // morreu no meio — pm2 restart). Não há multi-worker hoje; o lease protege
  // contra o restart, não contra concorrência.
  leaseExpiresAt DateTime?
  resultFileName String?
  // Varreduras extras de swap pós-conclusão: cobrem a corrida "produto salvo
  // com a WebP DEPOIS do swap principal" (+2min e +10min).
  swapSweepsLeft Int       @default(2)
  nextSweepAt    DateTime?
  lastError      String?
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextRunAt])
  @@index([userId, createdAt])
}

// Receita de edição do Editor de Imagem (PR 6): cada SAVE gera um arquivo
// NOVO (`fileName` @unique, nunca sobrescreve — versionamento por uuid) e
// grava aqui a receita JSON (EditRecipeV1) + os arquivos-fonte, permitindo
// reabrir a edição do ponto onde parou e o restore não-destrutivo do PR 8.
// O GC (cleanup-orphan-originals) considera sourceFileName/cutoutFileName
// referenciados enquanto a linha existir.
model ProductImageEdit {
  id             String   @id @default(cuid())
  // Arquivo de SAÍDA gravado em public/uploads (ex.: "abc.png"/"abc.jpg").
  fileName       String   @unique
  // Imagem-base da edição (o que o usuário abriu no editor).
  sourceFileName String
  // Recorte PNG usado como camada-base, quando havia (restore do PR 8).
  cutoutFileName String?
  recipe         Json
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
}

// Biblioteca de imagens reutilizáveis do Editor (PR 7): veículos que o
// usuário envia uma vez e insere em quantos anúncios quiser (padrão
// "peça + carro compatível"). O arquivo referenciado fica protegido do GC
// enquanto a linha existir; remover da biblioteca apaga SÓ a linha (receitas
// antigas que usam o arquivo continuam restauráveis).
model EditorAsset {
  id        String   @id @default(cuid())
  userId    String
  // Basename em public/uploads (saída do pipeline normal de upload).
  fileName  String
  label     String?
  kind      String   @default("vehicle")
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// Teto financeiro DIÁRIO dos provedores externos de recorte (PR 5). Uma linha
// por (provedor, dia UTC "YYYY-MM-DD"); a reserva é increment condicional
// (count < teto) — atômica, sobrevive a restart e vale entre processos.
model ProviderDailyUsage {
  id        String   @id @default(cuid())
  provider  String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([provider, day])
}

model BulkListingJob {
  id               String        @id @default(cuid())
  userId           String
  status           BulkJobStatus @default(QUEUED)
  totalItems       Int
  doneItems        Int           @default(0)
  successItems     Int           @default(0)
  failedItems      Int           @default(0)
  productIds       String[]
  requests         Json
  overrideTemplate Json?
  results          Json          @default("[]")
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model MLCategoryAttributeCache {
  categoryId   String   @id
  attributes   Json
  fetchedAt    DateTime @default(now())
  ttlExpiresAt DateTime

  @@index([ttlExpiresAt])
}

model ShopeeCategoryAttribute {
  id           String   @id @default(cuid())
  region       String
  categoryId   Int
  locale       String
  attributes   Json
  source       String
  fetchedAt    DateTime @default(now())
  ttlExpiresAt DateTime

  @@unique([region, categoryId, locale])
  @@index([ttlExpiresAt])
  @@index([categoryId])
}

model WebhookEventLog {
  id         String   @id @default(cuid())
  source     String
  externalId String
  payload    Json?
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([createdAt])
}

model SyncLog {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  type                 SyncType
  status               SyncStatus
  message              String?
  payload              Json?
  createdAt            DateTime           @default(now())
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@index([marketplaceAccountId])
  // PERF: serve o COUNT do health-check de token (sync.usercase logSync) —
  // WHERE marketplaceAccountId AND status=FAILURE AND createdAt>=now()-30min.
  // NÃO substitui o índice simples acima (deleteMany de conta o usa).
  // DDL manual em produção; este @@index é o espelho.
  @@index([marketplaceAccountId, status, createdAt])
}

model SystemLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  level      LogLevel
  message    String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  // Taxa de fallback do pipeline de imagem (rembg-telemetry): 2 COUNTs por
  // action+janela — sem este índice viraria seq scan na tabela inteira.
  // DDL manual em produção; este @@index é o espelho. Migração:
  // CREATE INDEX IF NOT EXISTS "SystemLog_action_createdAt_idx"
  //   ON "SystemLog"("action", "createdAt");
  @@index([action, createdAt])
}

enum Role {
  ADMIN
  USER
  // Equipe Dexo (superadmin). Aditivo — marcado manualmente no banco; app
  // reconhece o valor e libera as telas/rotas de Superadmin. Migração:
  // ALTER TYPE "Role" ADD VALUE IF NOT EXISTS 'SUPERADMIN';
  SUPERADMIN
}

enum Quality {
  SUCATA
  SEMINOVO
  NOVO
  RECONDICIONADO
}

enum Platform {
  MERCADO_LIVRE
  SHOPEE
  MAGALU
  OLX
  FACEBOOK
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SyncType {
  STOCK_UPDATE
  ORDER_IMPORT
  AUTH_REFRESH
  PRODUCT_SYNC
}

enum SyncStatus {
  SUCCESS
  FAILURE
  WARNING
}

enum LogLevel {
  INFO
  WARNING
  ERROR
}

enum BulkJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED_PARTIAL
  FAILED
}

enum ScrapStatus {
  AVAILABLE
  IN_USE
  DEPLETED
  ARCHIVED
}

// Status logístico/físico do veículo no pátio (pipeline de desmembramento).
// ORTOGONAL ao ScrapStatus (inventário): uma sucata pode estar IN_YARD e AVAILABLE.
enum LogisticsStatus {
  IN_TRANSIT // Em Trânsito: arrematado, em deslocamento para a loja
  IN_YARD // No Pátio: chegou, veículo inteiro
  ON_LIFT // No Elevador: em desmontagem ativa
  DISMANTLED // Desmembrado: concluído, peças cadastradas
}

enum FinanceStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

// Estado do orçamento (proposta ao cliente). Aditivo e isolado do FinanceStatus.
// EXPIRADO é DERIVADO de validUntil em read-time (não persistido), igual ao
// VENCIDA do Receivable. CONVERTIDO/CANCELADO são transições explícitas.
enum BudgetStatus {
  ABERTO
  CONVERTIDO
  EXPIRADO
  CANCELADO
}

// Estágio do funil de CRM (2ª dimensão ADITIVA e NULLABLE, ortogonal a
// BudgetStatus). A coluna do kanban é DERIVADA em read-time a partir de
// (status + pipelineStage) — ver deriveColumn no front. NUNCA governa
// editar/converter/cancelar (isso continua sendo papel de BudgetStatus).
// Sem default destrutivo: orçamentos antigos ficam NULL e derivam para "Novo".
enum BudgetStage {
  NOVO
  EM_NEGOCIACAO
  PROPOSTA_ENVIADA
  GANHO
  PERDIDO
  CANCELADO
}

model Customer {
  id     String @id @default(cuid())
  userId String

  // Tipo de pessoa. Default PF preserva todos os clientes existentes.
  personType String @default("PF") // PF | PJ

  // Identificação PF
  name          String
  cpf           String?
  rg            String?
  birthDate     DateTime?
  gender        String?
  maritalStatus String?

  // Identificação PJ (quando personType = PJ)
  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  indicadorIE       String? @default("9") // 1=Contribuinte | 2=Isento | 9=Não contribuinte

  email  String?
  phone  String?
  mobile String?

  // Endereço principal
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  ibge         String?
  reference    String?

  // Dados adicionais / entrega (PJ ou 2º endereço)
  deliveryName          String?
  deliveryCorporateName String?
  deliveryCpf           String?
  deliveryCnpj          String?
  deliveryRg            String?
  deliveryCep           String?
  deliveryPhone         String?
  deliveryCity          String?
  deliveryNeighborhood  String?
  deliveryState         String?
  deliveryStreet        String?
  deliveryComplement    String?
  deliveryNumber        String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  payables     Payable[]
  receivables  Receivable[]
  budgets      Budget[]
  nfesEmitidas NfeEmitida[]
  orders       Order[]

  @@unique([userId, cpf])
  @@index([userId, createdAt])
  @@index([userId, name])
  @@index([userId, cnpj])
}

model Receivable {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?

  document    String?
  reason      String?
  debtDetails String?
  totalAmount Decimal @db.Decimal(12, 2)

  fineAmount      Decimal? @db.Decimal(12, 2)
  finePercent     Decimal? @db.Decimal(5, 2)
  interestPercent Decimal? @db.Decimal(5, 2)
  toleranceDays   Int?

  installments Int      @default(1)
  periodDays   Int?
  dueDate      DateTime

  status FinanceStatus @default(PENDENTE)
  paidAt DateTime?

  // Forma de pagamento (opcional). Código estável de app/lib/payment-methods.ts
  // (PIX/CREDITO/DEBITO/BOLETO/DINHEIRO/TRANSFERENCIA). Nulável: conta sem
  // método é válida (zero regressão). String? em vez de enum p/ flexibilidade.
  //
  // Bloco A: com N formas na mesma venda este campo continua preenchido e
  // continua sendo UM dos 7 códigos — o método PREDOMINANTE (o de maior
  // valor). É o que mantém intactos os 41 pontos que o leem: coluna "Forma",
  // filtro da listagem, KPIs, dashboards, relatório e mapeamento fiscal.
  // O detalhamento vive em `payments`.
  paymentMethod String?

  // Conta originada da conversão de um Orçamento (aditivo, default NULL).
  // @unique => 1:1 (um orçamento converte em no máximo uma conta). onDelete
  // SetNull no lado do orçamento: apagar o orçamento NÃO apaga a venda já
  // convertida. Setado SOMENTE pela conversão (não exposto no DTO de finance).
  budgetId String? @unique

  // ── Bloco B: entrada + parcelamento do saldo ──
  // A venda vira 1 conta-ENTRADA (esta, que carrega os itens) + N contas-
  // PARCELA (filhas, sem itens). Cada parcela é um Receivable comum, então
  // baixa individual, vencimento próprio, VENCIDA derivada e encargos por
  // parcela já funcionam pelos caminhos que existem — sem status novo no enum
  // e sem tocar markPaid/summary/dashboards.
  //
  // Soma sem dupla contagem: entrada + parcelas = total da venda. Cada real
  // aparece em exatamente uma linha.
  //
  // SetNull (não Cascade): apagar a conta-entrada NUNCA pode sumir com
  // parcelas que o cliente ainda deve. O `delete` bloqueia esse caminho e
  // manda estornar; o SetNull é só a rede de segurança do banco.
  parentReceivableId String?
  // 1..N dentro do split; NULL em conta normal. `installments` (escalar
  // antigo) fica 1 na parcela — ela É uma cobrança única.
  installmentNumber  Int?
  installmentTotal   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id])
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade  Unidade?            @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  items    ReceivableItem[]
  payments ReceivablePayment[]
  budget   Budget?             @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  parent   Receivable?  @relation("ReceivableSplit", fields: [parentReceivableId], references: [id], onDelete: SetNull)
  children Receivable[] @relation("ReceivableSplit")

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([customerId])
  @@index([userId, unidadeId])
  @@index([parentReceivableId])
}

// Nota de negócio: Payable também referencia Customer por regra explícita do usuário.
model Payable {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?

  document    String?
  reason      String?
  debtDetails String?
  totalAmount Decimal @db.Decimal(12, 2)

  fineAmount      Decimal? @db.Decimal(12, 2)
  finePercent     Decimal? @db.Decimal(5, 2)
  interestPercent Decimal? @db.Decimal(5, 2)
  toleranceDays   Int?

  installments Int      @default(1)
  periodDays   Int?
  dueDate      DateTime

  status FinanceStatus @default(PENDENTE)
  paidAt DateTime?

  // Forma de pagamento (opcional). Ver Receivable.paymentMethod.
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade  Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([customerId])
  @@index([userId, unidadeId])
}

// Item de venda balcão vinculado a uma Conta a Receber.
// Snapshot do preço no momento da venda (unitPrice não acompanha mudanças em
// Product.price). Cascade do Receivable: apagar receivable apaga seus itens
// (no fluxo PENDENTE/sem-pagamento — o estorno de conta PAGA é via
// FinanceUseCase.reverse, fora do cascade). Restrict no Product preserva
// integridade do histórico para produtos vendidos no balcão (não regride o
// delete atual: nenhum produto existente tem ReceivableItem).
model ReceivableItem {
  id           String   @id @default(cuid())
  receivableId String
  // productId nulável (aditivo): item MANUAL (texto livre) não tem produto
  // cadastrado. Itens existentes mantêm productId setado — zero regressão.
  productId    String?
  // Descrição do item manual (texto livre). NULL p/ item cadastrado (a
  // descrição vem do Product). Preenchida só quando productId é NULL.
  description  String?
  // Bloco F — opt-in do operador: "criar no catálogo" na linha do item manual.
  // DEFAULT FALSE é o que garante a RETROATIVIDADE: todo ReceivableItem já
  // gravado nasce false, então ligar a flag NÃO mexe em nada do histórico.
  createCatalogProduct Boolean @default(false)
  // Bloco F — este `productId` foi criado automaticamente a partir deste item
  // manual? Âncora do estorno simétrico: só nestes itens o estorno faz a saída
  // compensatória para o produto voltar a estoque 0 (sem produto fantasma).
  autoCreatedProduct   Boolean @default(false)
  // Sucata de origem da venda (override explícito; precede Product.scrapId na
  // agregação). NULL = sucata efetiva derivada do Product, se houver.
  scrapId      String?
  listingId    String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  receivable Receivable      @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  scrap      Scrap?          @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listing    ProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([receivableId])
  @@index([productId])
  @@index([scrapId])
  @@index([listingId])
}

// Bloco A — linhas de pagamento de uma venda (PIX + dinheiro + cartão na mesma
// compra). Tabela FILHA e puramente aditiva: `Receivable.paymentMethod`
// continua existindo e guardando o método PREDOMINANTE, então nada do que já
// lê aquele campo precisa saber que isto existe.
//
// Venda com UMA forma não grava linha aqui — o payload segue idêntico ao atual.
// Cascade espelha ReceivableItem: apagar a conta leva os pagamentos junto,
// senão sobrariam linhas órfãs somando dinheiro.
model ReceivablePayment {
  id           String   @id @default(cuid())
  receivableId String
  // Código estável de app/lib/payment-methods.ts. String em vez de enum: a
  // fonte da verdade é a aplicação, e um enum exigiria DDL a cada forma nova.
  method       String
  amount       Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId])
}

// Orçamento (proposta de venda ao cliente). Espelha Receivable/ReceivableItem
// para reaproveitar 1:1 o picker de itens e alimentar o fluxo de venda balcão
// na conversão. ADITIVO e ISOLADO: não toca nenhuma query de Receivable/Payable.
// Escopo por userId (= dataOwnerId), igual a Customer/Receivable. EXPIRADO é
// derivado de validUntil em read-time (não persistido).
model Budget {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?
  // Vendedor atribuído (colaborador OU o próprio admin) — aditivo, nullable.
  // Alimenta a estatística de orçamentos por vendedor (comissão).
  vendedorId String?

  // Cabeçalho (espelha os campos human-facing de Receivable que um orçamento usa).
  document    String?
  reason      String?
  notes       String? // observações / condições (texto livre)
  totalAmount Decimal @db.Decimal(12, 2)

  status     BudgetStatus @default(ABERTO)
  validUntil DateTime? // validade do orçamento; alimenta EXPIRADO (read-time)

  // CRM (aditivo, nullable). pipelineStage = posição no funil; lostReason =
  // motivo opcional ao mover p/ Perdido. NULL = orçamento antigo → deriva "Novo".
  // NÃO altera a semântica de status/convert/cancel/update.
  pipelineStage BudgetStage?
  lostReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User         @relation("BudgetOwner", fields: [userId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade    Unidade?     @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  // Vendedor: colaborador (children) OU o próprio admin. onDelete SetNull —
  // remover o usuário não apaga o orçamento (preserva histórico/estatística).
  vendedor   User?        @relation("BudgetVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  items      BudgetItem[]
  // Back-relation 1:1 do Receivable.budgetId (preenchida na conversão).
  receivable Receivable?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([userId, unidadeId])
  @@index([userId, vendedorId])
  @@index([userId, pipelineStage])
}

// Item do orçamento. Mesma forma do ReceivableItem (productId? | description? +
// scrapId?/listingId? + quantity + unitPrice snapshot) para a conversão copiar
// 1:1. Cascade do Budget; Restrict no Product (integridade histórica).
model BudgetItem {
  id          String   @id @default(cuid())
  budgetId    String
  productId   String? // NULL = item manual (texto livre)
  description String? // descrição do item manual; NULL p/ item cadastrado
  scrapId     String? // sucata de origem (override explícito)
  listingId   String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  budget  Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  scrap   Scrap?          @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listing ProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([productId])
  @@index([scrapId])
  @@index([listingId])
}

// Unidade (filial / loja física) — escopo por userId (= dataOwnerId), igual a
// Customer/Location. Soft-delete via `active` porque Receivable/Payable têm FK
// para cá; inativar preserva histórico e a semântica de "Sem unidade".
model Unidade {
  id        String   @id @default(cuid())
  userId    String
  name      String
  code      String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  receivables Receivable[]
  payables    Payable[]
  budgets     Budget[]

  @@unique([userId, code])
  @@index([userId, name])
}

model Scrap {
  id     String @id @default(cuid())
  userId String

  // Dados do veículo
  brand              String
  model              String
  // Apelido do veículo (identificação humana no pátio, ex.: "Gol bola azul").
  // Migração: ALTER TABLE "Scrap" ADD COLUMN "nickname" TEXT;
  nickname           String?
  year               String?
  version            String?
  color              String?
  plate              String?
  chassis            String?
  engineNumber       String?
  renavam            String?
  lot                String?
  deregistrationCert String?

  // Custo e pagamento
  cost          Decimal? @db.Decimal(10, 2)
  extraCosts    Decimal? @db.Decimal(10, 2) // transporte/guincho/taxas (Investimento = cost + extraCosts)
  paymentMethod String?

  // Localização (referência à entidade Location existente)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Dados fiscais / NF-e
  ncm             String?
  supplierCnpj    String?
  accessKey       String?
  issueDate       DateTime?
  entryDate       DateTime?
  nfeNumber       String?
  nfeProtocol     String?
  operationNature String?
  nfeSeries       String?
  fiscalModel     String?
  icmsValue       Decimal?  @db.Decimal(10, 2)
  icmsCtValue     Decimal?  @db.Decimal(10, 2)
  freightMode     String?
  issuePurpose    String?

  // Imagens/Anexos
  imageUrls String[] @default([])

  // Status e controle
  status          ScrapStatus     @default(AVAILABLE)
  logisticsStatus LogisticsStatus @default(IN_YARD)
  notes           String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user            User               @relation(fields: [userId], references: [id])
  products        Product[]
  statusEvents    ScrapStatusEvent[]
  // Vendas balcão (Conta a Receber) vinculadas diretamente a esta sucata —
  // inclui itens manuais (sem Product). onDelete SetNull no lado do item.
  receivableItems ReceivableItem[]
  // Itens de orçamento vinculados a esta sucata (mesma semântica do balcão).
  budgetItems     BudgetItem[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, logisticsStatus])
  @@index([plate])
  @@index([chassis])
}

// Histórico de transições de estágio logístico (diferencial F). Aditivo:
// gravado a cada transição; base para medir tempo por estágio e leilão→desmembrado.
model ScrapStatusEvent {
  id         String           @id @default(cuid())
  scrapId    String
  userId     String
  fromStatus LogisticsStatus?
  toStatus   LogisticsStatus
  createdAt  DateTime         @default(now())

  scrap Scrap @relation(fields: [scrapId], references: [id], onDelete: Cascade)

  @@index([scrapId, createdAt])
  @@index([userId, createdAt])
}

// =====================================================================
// Módulo Fiscal (NF-e)
// Additive-only: nenhuma alteração destrutiva em models existentes.
// =====================================================================

model CompanyFiscalConfig {
  id     String @id @default(cuid())
  // Multi-CNPJ: 1:N por tenant. O antigo @unique(userId) virou índice normal;
  // "no máximo 1 default por user" é garantido por unique PARCIAL no banco
  // ((userId) WHERE "isDefault" — DB-managed, Prisma não representa índice
  // parcial; ver docs/multi-cnpj-sql.md).
  userId String

  // CNPJ padrão do tenant — usado por todo caminho que não seleciona emitente
  // explicitamente (rotas legadas /fiscal/config*, PDV sem seletor, budget/finance).
  isDefault Boolean @default(false)

  cnpj               String
  razaoSocial        String
  nomeFantasia       String?
  inscricaoEstadual  String
  inscricaoMunicipal String?
  regimeTributario   String // SIMPLES | LUCRO_PRESUMIDO | LUCRO_REAL
  cnae               String?

  ambiente String @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO

  // Endereço fiscal
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  municipio    String?
  codMunicipio String?
  uf           String?
  codPais      String? @default("1058")
  pais         String? @default("BRASIL")

  // Certificado A1
  certificadoPath      String?
  certificadoSenhaEnc  String?
  certificadoValidoAte DateTime?
  certificadoSubjectCN String? // CN do titular do A1 (ex.: "RAZAO:CNPJ") — exibição + reconferência do CNPJ

  // Provedor fiscal
  providerName  String? // FOCUS_NFE | ...
  providerToken String? // encriptado

  // Numeração — série padrão das NF-e desta empresa (o número é sequencial
  // automático por série/ambiente via NfeSequence). Default 1 preserva o
  // comportamento anterior (série hardcoded 1).
  serieNfe Int @default(1)

  // ── NFC-e (modelo 65) — Fase 2 do PDV. Campos ADITIVOS; nulos/default
  // preservam 100% o comportamento da NF-e 55. ──
  // Série própria da NFC-e (numeração independente por modelo via NfeSequence).
  serieNfce Int @default(1)
  // CSC (Código de Segurança do Contribuinte) — usado no hash do QR Code.
  // cscId = idCSC/cIdToken; cscToken = o código em si (segredo: NUNCA volta ao
  // cliente — ver sanitizeFiscalConfig; preserve-when-blank igual providerToken).
  cscId    String?
  cscToken String?
  // NCM padrão (8 dígitos) — autopreenche itens sem NCM na emissão NFC-e do PDV
  // e no wizard da NF-e 55. NCM continua obrigatório na emissão.
  ncmPadrao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, cnpj])
  @@index([userId])
}

model NfeSequence {
  id            String   @id @default(cuid())
  userId        String
  ambiente      String // HOMOLOGACAO | PRODUCAO
  serie         Int
  // Modelo do documento (55 = NF-e, 65 = NFC-e). Default '55' preserva as
  // linhas/numeração existentes; NFC-e ganha contador próprio por série.
  modelo        String   @default("55")
  proximoNumero Int      @default(1)
  updatedAt     DateTime @updatedAt

  // Multi-CNPJ: numeração fiscal é POR CNPJ. A unicidade real vive em uniques
  // PARCIAIS no banco (DB-managed, ver docs/multi-cnpj-sql.md):
  //   (companyFiscalConfigId, ambiente, serie, modelo) WHERE configId IS NOT NULL
  //   (userId, ambiente, serie, modelo)                WHERE configId IS NULL (legado)
  // O @@unique antigo por userId virou índice normal — dois CNPJs do mesmo
  // tenant podem compartilhar serie/modelo sem colidir.
  companyFiscalConfigId String?

  @@index([userId, ambiente, serie, modelo])
  @@index([companyFiscalConfigId])
  @@index([userId])
}

model NfeEmitida {
  id         String  @id @default(cuid())
  userId     String
  orderId    String?
  customerId String?

  // Multi-CNPJ: emitente (CompanyFiscalConfig.id) resolvido na criação do
  // draft e gravado também na numeração. NULL = era 1-CNPJ (default do tenant)
  // — a emissão faz fallback ao default e adota a linha. Unicidade real por
  // CNPJ em unique PARCIAL no banco (ver docs/multi-cnpj-sql.md):
  //   (companyFiscalConfigId, ambiente, serie, numero, modelo)
  //   WHERE configId IS NOT NULL AND numero > 0   (drafts usam numero negativo)
  companyFiscalConfigId String?

  // Identificação
  ambiente                  String // HOMOLOGACAO | PRODUCAO
  modelo                    String    @default("55")
  serie                     Int
  numero                    Int
  chaveAcesso               String?   @unique
  tipoOperacao              String // ENTRADA | SAIDA
  finalidade                String // NORMAL | COMPLEMENTAR | AJUSTE | DEVOLUCAO
  destinoOperacao           String // INTERNA | INTERESTADUAL | EXTERIOR
  naturezaOperacao          String
  indPresenca               String // 0..9
  intermediador             String?
  numeroPedido              String?
  // Observações nível-nota: vão ao <infAdic><infCpl> do XML e ao DANFE
  informacoesComplementares String?
  dataEmissao               DateTime?
  dataSaida                 DateTime?

  // Snapshots imutáveis pós-emissão
  destinatarioJson Json
  emitenteJson     Json?

  // Frete
  modalidadeFrete    String?
  transportadoraJson Json?

  // Totalizadores e blocos
  totaisJson             Json?
  notasReferenciadasJson Json?
  exportacaoJson         Json?
  pagamentosJson         Json?
  duplicatasJson         Json?
  volumesJson            Json?

  // Estado
  status               String // DRAFT | VALIDATING | SIGNING | SENDING | AUTHORIZED | REJECTED | CANCELLED | INUTILIZED
  protocoloAutorizacao String?
  dataAutorizacao      DateTime?
  motivoRejeicao       String?
  // cStat da última rejeição (SEFAZ). Distingue rejeição reaproveitável (número
  // não consumido) de denegada (110)/duplicidade (já consumido). null = legado.
  cStatRejeicao        Int?

  // Artefatos
  xmlOriginalPath   String?
  xmlAssinadoPath   String?
  xmlAutorizadoPath String?
  danfePdfPath      String?

  // Auditoria
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emittedByUserId String

  // Relações
  user     User          @relation(fields: [userId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  itens    NfeItem[]
  eventos  NfeAuditLog[]

  // `modelo` no índice: numeração da NFC-e (65) é independente da NF-e (55) —
  // série 1/número N podem existir nos dois modelos sem colisão. O antigo
  // @@unique por userId virou índice normal (multi-CNPJ); a unicidade real é
  // por companyFiscalConfigId em unique parcial DB-managed.
  @@index([userId, ambiente, serie, numero, modelo])
  @@index([companyFiscalConfigId])
  @@index([userId, status])
  @@index([userId, dataEmissao])
  @@index([orderId])
  @@index([customerId])
}

model NfeItem {
  id            String   @id @default(cuid())
  nfeId         String
  productId     String?
  numero        Int
  codigo        String
  descricao     String
  ncm           String
  cfop          String
  cest          String?
  origem        Int
  unidade       String
  quantidade    Decimal  @db.Decimal(15, 4)
  valorUnitario Decimal  @db.Decimal(15, 4)
  valorTotal    Decimal  @db.Decimal(15, 2)
  desconto      Decimal? @db.Decimal(15, 2)
  observacoes   String?
  tributosJson  Json?

  nfe     NfeEmitida @relation(fields: [nfeId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([nfeId])
  @@index([productId])
}

model NfeAuditLog {
  id        String   @id @default(cuid())
  nfeId     String
  userId    String
  evento    String // CRIADA | EDITADA_DRAFT | VALIDADA | NUMERADA | ASSINADA | ENVIADA | AUTORIZADA | REJEITADA | CANCELADA | INUTILIZADA | XML_REENVIADO
  detalhes  Json?
  createdAt DateTime @default(now())

  nfe NfeEmitida @relation(fields: [nfeId], references: [id], onDelete: Cascade)

  @@index([nfeId])
  @@index([userId])
}

model NfeInutilizacao {
  id            String   @id @default(cuid())
  userId        String
  // Multi-CNPJ: emitente da faixa inutilizada. NULL = era 1-CNPJ (default).
  companyFiscalConfigId String?
  ambiente      String
  serie         Int
  numeroInicial Int
  numeroFinal   Int
  justificativa String
  protocolo     String?
  status        String // PENDENTE | ACEITA | REJEITADA
  respostaJson  Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// =============================================================================
// Caixa de mensagens (perguntas pré-venda do Mercado Livre).
// Snapshot local alimentado por webhook (topic="questions") e pull on-demand.
// Isolado dos fluxos de listing/order — apenas FK opcional para ProductListing
// para enriquecer a UI (nada quebra se a listing local não existir).
// =============================================================================

model MarketplaceQuestion {
  id                   String    @id @default(cuid())
  marketplaceAccountId String
  productListingId     String?
  externalQuestionId   String
  externalItemId       String
  externalBuyerId      String
  buyerNickname        String?
  text                 String    @db.Text
  status               String // UNANSWERED | ANSWERED | CLOSED_UNANSWERED | UNDER_REVIEW | BANNED | DELETED
  // Autor da mensagem em conversas de CHAT (Magalu): CUSTOMER | SELLER. Aditivo
  // e nullable: ML/Shopee (Q&A 1:1) deixam NULL e seguem usando `answer`. Quando
  // preenchido, a linha é UMA mensagem do chat (sem MarketplaceAnswer) e a UI
  // renderiza por authorType (SELLER à direita / CUSTOMER à esquerda).
  authorType           String?
  dateCreated          DateTime
  lastSyncedAt         DateTime  @default(now())
  readAt               DateTime?

  answer             MarketplaceAnswer?
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id])
  productListing     ProductListing?    @relation(fields: [productListingId], references: [id])

  @@unique([marketplaceAccountId, externalQuestionId])
  @@index([marketplaceAccountId, status, dateCreated])
  @@index([marketplaceAccountId, externalItemId, dateCreated])
  @@index([marketplaceAccountId, readAt])
  @@index([productListingId])
}

model MarketplaceAnswer {
  id          String   @id @default(cuid())
  questionId  String   @unique
  text        String   @db.Text
  dateCreated DateTime
  status      String // ACTIVE | DELETED | DISABLED

  question MarketplaceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// =============================================================================
// WhatsApp (Cloud API oficial da Meta) — canal de MENSAGENS, não marketplace.
// Tabelas próprias de propósito: NÃO entra no enum Platform (sem anúncios,
// pedidos ou OAuth de venda) e NÃO reutiliza MarketplaceQuestion (P&R de
// anúncio ≠ chat livre por contato). O canal "WHATSAPP" existe só em DTO/UI.
// Módulo atrás de NEXT_PUBLIC_WHATSAPP_MODULE_ENABLED (kill-switch global) +
// User.whatsappEnabledAt (gate por plano, por tenant).
// =============================================================================

// Uma conta = um número conectado (phone_number_id da Cloud API).
model WhatsAppAccount {
  id                 String  @id @default(cuid())
  userId             String
  wabaId             String
  phoneNumberId      String  @unique
  displayPhoneNumber String
  verifiedName       String?
  // Token de acesso (System User / Business Integration) — criptografado em
  // repouso via SecretCipher (AES-256-GCM, chave MARKETPLACE_TOKEN_ENC_KEY).
  accessToken        String
  // Onboarding manual multi-cliente: o webhook é configurado por APP Meta, e a
  // assinatura X-Hub-Signature-256 usa o App Secret do app DO CLIENTE. Ambos
  // opcionais (fallback para WHATSAPP_APP_ID/WHATSAPP_APP_SECRET do env).
  appId              String?
  appSecret          String? // criptografado via SecretCipher

  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  conversations WhatsAppConversation[]

  @@index([userId])
}

// Uma conversa = um contato (wa_id) dentro de um número. O `id` (cuid) é usado
// como `externalItemId` na UI de mensagens — identidade única global, exigida
// porque a lista/seleção da aba chaveia só por esse campo.
model WhatsAppConversation {
  id                String  @id @default(cuid())
  whatsAppAccountId String
  contactWaId       String
  contactName       String?

  lastMessageAt        DateTime
  lastMessagePreview   String?   @db.Text
  // INBOUND | OUTBOUND — deriva "Pendente"/answered na lista (última msg do
  // cliente sem resposta = pendente).
  lastMessageDirection String?
  unreadCount          Int       @default(0)
  // Janela de atendimento de 24h da Cloud API: última msg INBOUND + 24h.
  // Fora da janela, texto livre é rejeitado (erro 131047) — só template.
  serviceWindowExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  WhatsAppAccount   @relation(fields: [whatsAppAccountId], references: [id])
  messages WhatsAppMessage[]

  @@unique([whatsAppAccountId, contactWaId])
  @@index([whatsAppAccountId, lastMessageAt])
}

// Uma linha por mensagem (entrada e saída). Idempotência pelo wamid.
model WhatsAppMessage {
  id             String  @id @default(cuid())
  conversationId String
  waMessageId    String  @unique // wamid da Cloud API — dedup/idempotência
  direction      String // INBOUND | OUTBOUND
  type           String // text | image | document | audio | unsupported | ...
  text           String? @db.Text
  mediaId        String?
  mediaMimeType  String?
  // Caminho local PRIVADO (.whatsapp-storage/) após download — mídia de cliente
  // nunca vai para public/uploads; o serving é por rota autenticada.
  mediaPath      String?
  // Status de entrega (só OUTBOUND): sent | delivered | read | failed | played.
  status         String?
  errorCode      String?
  timestamp      DateTime
  raw            Json?
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, timestamp])
}
