generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String   @id @default(cuid())
  name                      String?
  email                     String   @unique
  password                  String
  avatarUrl                 String?
  role                      Role     @default(USER)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  defaultProductDescription String?
  defaultCostPrice          Decimal? @db.Decimal(10, 2)
  defaultStock              Int?     @default(0)

  // Padrões de anúncio ML (preferências do usuário)
  defaultListingType       String? // "bronze" | "gold_special" | "gold_pro"
  defaultHasWarranty       Boolean? @default(false)
  defaultWarrantyUnit      String? // "dias" | "meses"
  defaultWarrantyDuration  Int?
  defaultItemCondition     String? // "new" | "used"
  defaultShippingMode      String? // "me2" | "me1" | "custom" | "not_specified"
  defaultFreeShipping      Boolean? @default(false)
  defaultLocalPickup       Boolean? @default(false)
  defaultManufacturingTime Int?     @default(0)

  // Aumento percentual escalonado de preço entre contas ML (anti-penalização
  // por anúncios idênticos). Valor padrão usado para pré-preencher o toggle no
  // wizard de anúncio em massa; 0 = desativado. Ver cross-account-price.service.
  crossAccountPriceIncreasePercent Decimal? @default(0) @db.Decimal(5, 2)

  // Contador do último SKU sequencial gerado pelo modal "Novo Produto".
  // Importações de estoque escrevem direto em Product e NÃO tocam aqui —
  // por isso o contador reflete só a sequência humana, sem contaminação
  // de códigos externos de fornecedor (códigos de barra etc).
  lastSkuSequential Int?

  // Acesso ao sistema. true = liberado (default), false = BLOQUEADO (ex.: falta
  // de pagamento). Bloquear NÃO apaga dados — é um "soft disable" reversível.
  // Default true => migração não bloqueia ninguém (zero regressão).
  isActive Boolean @default(true)

  // Hierarquia administrador → colaboradores (additive, default NULL).
  // Para usuários sem parentUserId, comportamento é idêntico ao anterior.
  parentUserId String?
  parent       User?   @relation("UserHierarchy", fields: [parentUserId], references: [id], onDelete: SetNull)
  children     User[]  @relation("UserHierarchy")

  accounts            MarketplaceAccount[]
  products            Product[]
  systemLogs          SystemLog[]
  locations           Location[]
  scraps              Scrap[]
  customers           Customer[]
  payables            Payable[]
  receivables         Receivable[]
  budgets             Budget[]            @relation("BudgetOwner")
  budgetsAsVendedor   Budget[]            @relation("BudgetVendedor")
  companyFiscalConfig CompanyFiscalConfig?
  nfesEmitidas        NfeEmitida[]
  bulkListingJobs     BulkListingJob[]
  unidades            Unidade[]

  @@index([parentUserId])
}

model Product {
  id                     String                 @id @default(cuid())
  sku                    String
  skuNormalized          String?
  name                   String
  description            String?
  price                  Decimal                @db.Decimal(10, 2)
  stock                  Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  costPrice              Decimal?               @db.Decimal(10, 2)
  markup                 Decimal?               @db.Decimal(10, 2)
  brand                  String?
  model                  String?
  year                   String?
  version                String?
  category               String?
  location               String?
  partNumber             String?
  partNumberNormalized   String?
  quality                Quality?
  isSecurityItem         Boolean                @default(false)
  isTraceable            Boolean                @default(false)
  sourceVehicle          String?
  imageUrl               String?
  imageUrls              String[]               @default([])
  mlCategoryId           String?
  heightCm               Int?
  lengthCm               Int?
  weightKg               Decimal?               @db.Decimal(6, 2)
  widthCm                Int?
  userId                 String?
  mlCategorySource       String?
  mlCategoryChosenAt     DateTime?
  shopeeCategoryId       String?
  shopeeCategorySource   String?
  shopeeCategoryChosenAt DateTime?
  locationId             String?
  scrapId                String?
  attributes             Json?
  mlCatalogProductId     String?
  mlCatalogSnapshot      Json?
  createdFromMarketplace Boolean                @default(false)
  originPlatform         Platform?
  orderItems             OrderItem[]
  compatibilities        ProductCompatibility[]
  mlCategory             MarketplaceCategory?   @relation("ProductMlCategory", fields: [mlCategoryId], references: [id])
  user                   User?                  @relation(fields: [userId], references: [id])
  productLocation        Location?              @relation(fields: [locationId], references: [id])
  scrap                  Scrap?                 @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listings               ProductListing[]
  stockLogs              StockLog[]
  nfeItens               NfeItem[]
  receivableItems        ReceivableItem[]
  budgetItems            BudgetItem[]

  @@unique([userId, sku])
  @@index([userId, skuNormalized])
  @@index([userId, partNumberNormalized])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([sku])
  @@index([locationId])
  @@index([scrapId])
  @@index([mlCatalogProductId])
}

model ProductCompatibility {
  id        String   @id @default(cuid())
  productId String
  brand     String
  model     String
  yearFrom  Int?
  yearTo    Int?
  version   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Estatísticas agregadas (determinísticas) dos produtos vivos de TODOS os
// usuários, recalculadas por um job noturno (scripts/build-catalog-stats.ts).
// Alimenta a "sugestão da base interna" no cadastro de produto. Contém SOMENTE
// agregados (mediana/moda/união/contagem) — NUNCA linha individual, userId,
// loja, costPrice ou markup (privacidade/LGPD). Só persiste chaves com
// sampleSize >= 5 (o limiar também é proteção contra expor um único concorrente).
// Tabela 100% reproduzível por execução: upsert por matchKey + prune por computedAt.
model CatalogStat {
  id String @id @default(cuid())

  // Identidade canônica/display: "partType|brand|model|version|yearFrom-yearTo".
  // Usada só para upsert idempotente; os lookups vão pelas colunas indexadas.
  matchKey String @unique

  // Colunas de lookup (normalizadas). Sentinela "*" quando o campo não se aplica
  // (ex.: linha version-agnóstica usa version = "*"). yearFrom/yearTo = faixa
  // min/max dos anos dos membros do grupo; o endpoint casa por interseção.
  partType String
  brand    String @default("*")
  model    String @default("*")
  version  String @default("*")
  yearFrom Int?
  yearTo   Int?

  // Tamanho da amostra. sampleSize = nº de membros do grupo (gate >= 5).
  // priceSampleSize = sobreviventes após corte de outliers IQR (transparência).
  sampleSize      Int
  priceSampleSize Int?

  // Medianas (preço usa SOMENTE `price` — nunca costPrice/markup).
  priceMedian    Decimal? @db.Decimal(10, 2)
  weightKgMedian Decimal? @db.Decimal(6, 2)
  heightCmMedian Int?
  widthCmMedian  Int?
  lengthCmMedian Int?

  // Modas (valor mais frequente + frequência). Só preenchidas quando freq >= 2.
  qualityMode            String?
  qualityModeCount       Int?
  partNumberMode         String?
  partNumberModeCount    Int?
  versionMode            String?
  versionModeCount       Int?
  sourceVehicleMode      String?
  sourceVehicleModeCount Int?
  mlCategoryIdMode       String?
  mlCategoryIdModeCount  Int?
  shopeeCategoryIdMode      String?
  shopeeCategoryIdModeCount Int?

  // Ficha técnica: { [attrId]: { value_id?, value_name?, freq } } (valor mais
  // frequente por chave de atributo). Compatibilidades: união deduplicada,
  // ranqueada por frequência: [{ brand, model, yearFrom, yearTo, version, freq }].
  attributes      Json?
  compatibilities Json?

  // Carimbo da execução do job; base da varredura de prune (deleteMany lt run).
  computedAt DateTime @default(now())

  @@index([partType, brand, model, version, sampleSize])
  @@index([partType, brand, model, version, yearFrom, yearTo])
  @@index([computedAt])
}

model Location {
  id          String     @id @default(cuid())
  userId      String
  code        String
  description String?
  maxCapacity Int        @default(0)
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  products    Product[]
  scraps      Scrap[]

  @@unique([userId, code])
  @@index([userId])
  @@index([parentId])
}

model MarketplaceAccount {
  id                          String                @id @default(cuid())
  userId                      String
  platform                    Platform
  accountName                 String
  accessToken                 String
  refreshToken                String
  expiresAt                   DateTime
  externalUserId              String?
  status                      AccountStatus         @default(ACTIVE)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  shopId                      Int?
  appClientId                 String?
  appClientSecret             String?
  autoImportListingsSince     DateTime?
  shopeeListingsSyncedThrough DateTime?
  user                        User                  @relation(fields: [userId], references: [id])
  orders                      Order[]
  listings                    ProductListing[]
  syncLogs                    SyncLog[]
  questions                   MarketplaceQuestion[]

  @@unique([platform, externalUserId])
  @@unique([platform, shopId])
  @@index([userId])
}

model ProductListing {
  id                   String    @id @default(cuid())
  productId            String
  marketplaceAccountId String
  externalListingId    String
  externalSku          String?
  status               String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  permalink            String?
  lastError            String?
  nextRetryAt          DateTime?
  retryAttempts        Int       @default(0)
  retryEnabled         Boolean   @default(false)
  requestedCategoryId  String?
  metricsUpdatedAt     DateTime?
  ratingAverage        Decimal?  @db.Decimal(3, 2)
  reviewsCount         Int       @default(0)
  viewsCount           Int       @default(0)
  listingType          String?
  itemCondition        String?
  hasWarranty          Boolean?
  warrantyUnit         String?
  warrantyDuration     Int?
  shippingMode         String?
  freeShipping         Boolean?
  localPickup          Boolean?
  manufacturingTime    Int?

  // Override fields: quando preenchidos, sobrescrevem o valor do produto
  // PARA ESTE ANÚNCIO ESPECÍFICO. NULL = herda do produto.
  // Estoque NÃO tem override por design (evita oversell — unidade física é
  // do produto e é replicada para todos os anúncios pelo SyncService).
  titleOverride           String?
  descriptionOverride     String?
  priceOverride           Decimal? @db.Decimal(10, 2)
  brandOverride           String?
  modelOverride           String?
  yearOverride            String?
  versionOverride         String?
  categoryOverride        String?
  mlCategoryOverride      String?
  shopeeCategoryOverride  String?
  partNumberOverride      String?
  qualityOverride         String?
  heightCmOverride        Int?
  widthCmOverride         Int?
  lengthCmOverride        Int?
  weightKgOverride        Float?
  imageUrlsOverride       Json?
  attributesOverride      Json?
  compatibilitiesOverride Json?
  sourceVehicleOverride   String?

  orderItems         OrderItem[]
  marketplaceAccount MarketplaceAccount    @relation(fields: [marketplaceAccountId], references: [id])
  product            Product               @relation(fields: [productId], references: [id])
  questions          MarketplaceQuestion[]
  receivableItems    ReceivableItem[]
  budgetItems        BudgetItem[]

  @@unique([marketplaceAccountId, externalListingId])
  @@index([marketplaceAccountId, metricsUpdatedAt])
  @@index([productId])
}

model MarketplaceCategory {
  id               String          @id @default(cuid())
  externalId       String          @unique
  siteId           String
  name             String
  fullPath         String
  pathFromRoot     Json
  parentExternalId String?
  keywords         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  aliases          CategoryAlias[]
  products         Product[]       @relation("ProductMlCategory")

  @@index([siteId])
  @@index([parentExternalId])
}

model CategoryAlias {
  id                    String              @id @default(cuid())
  marketplaceCategoryId String
  tokens                String?
  synonyms              String?
  brandModelPatterns    String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  marketplaceCategory   MarketplaceCategory @relation(fields: [marketplaceCategoryId], references: [id])

  @@index([marketplaceCategoryId])
}

model Order {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  externalOrderId      String
  status               OrderStatus        @default(PENDING)
  totalAmount          Decimal            @db.Decimal(10, 2)
  customerName         String?
  customerEmail        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id])
  items                OrderItem[]
  nfesEmitidas         NfeEmitida[]
  shipmentLabel        ShipmentLabel?

  @@unique([marketplaceAccountId, externalOrderId])
  @@index([marketplaceAccountId, createdAt])
  @@index([status, updatedAt])
}

// Etiqueta de envio (AWB/Mercado Envios) de um pedido. ADITIVO e 1:1 com Order
// (orderId @unique). Order não ganha colunas — só a relação virtual acima, que
// não gera DDL. Persiste o estado do fluxo: NF-e enviada ao marketplace →
// liberação → etiqueta gerada. labelStatus segue NONE|INVOICE_SENT|
// READY_TO_PRINT|GENERATED|ERROR. provider = "MERCADO_LIVRE" | "SHOPEE".
model ShipmentLabel {
  id             String    @id @default(cuid())
  orderId        String    @unique
  provider       String
  shipmentId     String?
  trackingNumber String?
  labelStatus    String    @default("NONE")
  labelSize      String?
  labelPdfPath   String?
  labelError     String?
  invoiceSentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal         @db.Decimal(10, 2)
  listingId String?
  listing   ProductListing? @relation(fields: [listingId], references: [id])
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])

  @@index([listingId])
  @@index([orderId])
  @@index([productId])
}

model StockLog {
  id            String   @id @default(cuid())
  productId     String
  change        Int
  reason        String
  previousStock Int
  newStock      Int
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([productId, createdAt])
}

model StockSyncJob {
  id          String   @id @default(cuid())
  productId   String
  listingId   String
  platform    Platform
  targetStock Int
  attempts    Int      @default(0)
  nextRunAt   DateTime @default(now())
  status      String   @default("PENDING")
  lastError   String?
  orderId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([listingId, status])
  @@index([status, nextRunAt])
  @@index([productId])
}

model BulkListingJob {
  id               String        @id @default(cuid())
  userId           String
  status           BulkJobStatus @default(QUEUED)
  totalItems       Int
  doneItems        Int           @default(0)
  successItems     Int           @default(0)
  failedItems      Int           @default(0)
  productIds       String[]
  requests         Json
  overrideTemplate Json?
  results          Json          @default("[]")
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model MLCategoryAttributeCache {
  categoryId   String   @id
  attributes   Json
  fetchedAt    DateTime @default(now())
  ttlExpiresAt DateTime

  @@index([ttlExpiresAt])
}

model ShopeeCategoryAttribute {
  id           String   @id @default(cuid())
  region       String
  categoryId   Int
  locale       String
  attributes   Json
  source       String
  fetchedAt    DateTime @default(now())
  ttlExpiresAt DateTime

  @@unique([region, categoryId, locale])
  @@index([ttlExpiresAt])
  @@index([categoryId])
}

model WebhookEventLog {
  id         String   @id @default(cuid())
  source     String
  externalId String
  payload    Json?
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@index([createdAt])
}

model SyncLog {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  type                 SyncType
  status               SyncStatus
  message              String?
  payload              Json?
  createdAt            DateTime           @default(now())
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  @@index([marketplaceAccountId])
}

model SystemLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  level      LogLevel
  message    String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
}

enum Quality {
  SUCATA
  SEMINOVO
  NOVO
  RECONDICIONADO
}

enum Platform {
  MERCADO_LIVRE
  SHOPEE
  MAGALU
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SyncType {
  STOCK_UPDATE
  ORDER_IMPORT
  AUTH_REFRESH
  PRODUCT_SYNC
}

enum SyncStatus {
  SUCCESS
  FAILURE
  WARNING
}

enum LogLevel {
  INFO
  WARNING
  ERROR
}

enum BulkJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED_PARTIAL
  FAILED
}

enum ScrapStatus {
  AVAILABLE
  IN_USE
  DEPLETED
  ARCHIVED
}

// Status logístico/físico do veículo no pátio (pipeline de desmembramento).
// ORTOGONAL ao ScrapStatus (inventário): uma sucata pode estar IN_YARD e AVAILABLE.
enum LogisticsStatus {
  IN_TRANSIT // Em Trânsito: arrematado, em deslocamento para a loja
  IN_YARD // No Pátio: chegou, veículo inteiro
  ON_LIFT // No Elevador: em desmontagem ativa
  DISMANTLED // Desmembrado: concluído, peças cadastradas
}

enum FinanceStatus {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

// Estado do orçamento (proposta ao cliente). Aditivo e isolado do FinanceStatus.
// EXPIRADO é DERIVADO de validUntil em read-time (não persistido), igual ao
// VENCIDA do Receivable. CONVERTIDO/CANCELADO são transições explícitas.
enum BudgetStatus {
  ABERTO
  CONVERTIDO
  EXPIRADO
  CANCELADO
}

// Estágio do funil de CRM (2ª dimensão ADITIVA e NULLABLE, ortogonal a
// BudgetStatus). A coluna do kanban é DERIVADA em read-time a partir de
// (status + pipelineStage) — ver deriveColumn no front. NUNCA governa
// editar/converter/cancelar (isso continua sendo papel de BudgetStatus).
// Sem default destrutivo: orçamentos antigos ficam NULL e derivam para "Novo".
enum BudgetStage {
  NOVO
  EM_NEGOCIACAO
  PROPOSTA_ENVIADA
  GANHO
  PERDIDO
  CANCELADO
}

model Customer {
  id     String @id @default(cuid())
  userId String

  // Tipo de pessoa. Default PF preserva todos os clientes existentes.
  personType String @default("PF") // PF | PJ

  // Identificação PF
  name          String
  cpf           String?
  rg            String?
  birthDate     DateTime?
  gender        String?
  maritalStatus String?

  // Identificação PJ (quando personType = PJ)
  cnpj              String?
  razaoSocial       String?
  nomeFantasia      String?
  inscricaoEstadual String?
  indicadorIE       String? @default("9") // 1=Contribuinte | 2=Isento | 9=Não contribuinte

  email  String?
  phone  String?
  mobile String?

  // Endereço principal
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  ibge         String?
  reference    String?

  // Dados adicionais / entrega (PJ ou 2º endereço)
  deliveryName          String?
  deliveryCorporateName String?
  deliveryCpf           String?
  deliveryCnpj          String?
  deliveryRg            String?
  deliveryCep           String?
  deliveryPhone         String?
  deliveryCity          String?
  deliveryNeighborhood  String?
  deliveryState         String?
  deliveryStreet        String?
  deliveryComplement    String?
  deliveryNumber        String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  payables     Payable[]
  receivables  Receivable[]
  budgets      Budget[]
  nfesEmitidas NfeEmitida[]

  @@unique([userId, cpf])
  @@index([userId, createdAt])
  @@index([userId, name])
  @@index([userId, cnpj])
}

model Receivable {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?

  document    String?
  reason      String?
  debtDetails String?
  totalAmount Decimal @db.Decimal(12, 2)

  fineAmount      Decimal? @db.Decimal(12, 2)
  finePercent     Decimal? @db.Decimal(5, 2)
  interestPercent Decimal? @db.Decimal(5, 2)
  toleranceDays   Int?

  installments Int      @default(1)
  periodDays   Int?
  dueDate      DateTime

  status FinanceStatus @default(PENDENTE)
  paidAt DateTime?

  // Forma de pagamento (opcional). Código estável de app/lib/payment-methods.ts
  // (PIX/CREDITO/DEBITO/BOLETO/DINHEIRO/TRANSFERENCIA). Nulável: conta sem
  // método é válida (zero regressão). String? em vez de enum p/ flexibilidade.
  paymentMethod String?

  // Conta originada da conversão de um Orçamento (aditivo, default NULL).
  // @unique => 1:1 (um orçamento converte em no máximo uma conta). onDelete
  // SetNull no lado do orçamento: apagar o orçamento NÃO apaga a venda já
  // convertida. Setado SOMENTE pela conversão (não exposto no DTO de finance).
  budgetId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade  Unidade?         @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  items    ReceivableItem[]
  budget   Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([customerId])
  @@index([userId, unidadeId])
}

// Nota de negócio: Payable também referencia Customer por regra explícita do usuário.
model Payable {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?

  document    String?
  reason      String?
  debtDetails String?
  totalAmount Decimal @db.Decimal(12, 2)

  fineAmount      Decimal? @db.Decimal(12, 2)
  finePercent     Decimal? @db.Decimal(5, 2)
  interestPercent Decimal? @db.Decimal(5, 2)
  toleranceDays   Int?

  installments Int      @default(1)
  periodDays   Int?
  dueDate      DateTime

  status FinanceStatus @default(PENDENTE)
  paidAt DateTime?

  // Forma de pagamento (opcional). Ver Receivable.paymentMethod.
  paymentMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade  Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([customerId])
  @@index([userId, unidadeId])
}

// Item de venda balcão vinculado a uma Conta a Receber.
// Snapshot do preço no momento da venda (unitPrice não acompanha mudanças em
// Product.price). Cascade do Receivable: apagar receivable apaga seus itens
// (no fluxo PENDENTE/sem-pagamento — o estorno de conta PAGA é via
// FinanceUseCase.reverse, fora do cascade). Restrict no Product preserva
// integridade do histórico para produtos vendidos no balcão (não regride o
// delete atual: nenhum produto existente tem ReceivableItem).
model ReceivableItem {
  id           String   @id @default(cuid())
  receivableId String
  // productId nulável (aditivo): item MANUAL (texto livre) não tem produto
  // cadastrado. Itens existentes mantêm productId setado — zero regressão.
  productId    String?
  // Descrição do item manual (texto livre). NULL p/ item cadastrado (a
  // descrição vem do Product). Preenchida só quando productId é NULL.
  description  String?
  // Sucata de origem da venda (override explícito; precede Product.scrapId na
  // agregação). NULL = sucata efetiva derivada do Product, se houver.
  scrapId      String?
  listingId    String?
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  receivable Receivable      @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  scrap      Scrap?          @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listing    ProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([receivableId])
  @@index([productId])
  @@index([scrapId])
  @@index([listingId])
}

// Orçamento (proposta de venda ao cliente). Espelha Receivable/ReceivableItem
// para reaproveitar 1:1 o picker de itens e alimentar o fluxo de venda balcão
// na conversão. ADITIVO e ISOLADO: não toca nenhuma query de Receivable/Payable.
// Escopo por userId (= dataOwnerId), igual a Customer/Receivable. EXPIRADO é
// derivado de validUntil em read-time (não persistido).
model Budget {
  id         String  @id @default(cuid())
  userId     String
  customerId String
  unidadeId  String?
  // Vendedor atribuído (colaborador OU o próprio admin) — aditivo, nullable.
  // Alimenta a estatística de orçamentos por vendedor (comissão).
  vendedorId String?

  // Cabeçalho (espelha os campos human-facing de Receivable que um orçamento usa).
  document    String?
  reason      String?
  notes       String? // observações / condições (texto livre)
  totalAmount Decimal @db.Decimal(12, 2)

  status     BudgetStatus @default(ABERTO)
  validUntil DateTime? // validade do orçamento; alimenta EXPIRADO (read-time)

  // CRM (aditivo, nullable). pipelineStage = posição no funil; lostReason =
  // motivo opcional ao mover p/ Perdido. NULL = orçamento antigo → deriva "Novo".
  // NÃO altera a semântica de status/convert/cancel/update.
  pipelineStage BudgetStage?
  lostReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User         @relation("BudgetOwner", fields: [userId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unidade    Unidade?     @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  // Vendedor: colaborador (children) OU o próprio admin. onDelete SetNull —
  // remover o usuário não apaga o orçamento (preserva histórico/estatística).
  vendedor   User?        @relation("BudgetVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  items      BudgetItem[]
  // Back-relation 1:1 do Receivable.budgetId (preenchida na conversão).
  receivable Receivable?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([userId, unidadeId])
  @@index([userId, vendedorId])
  @@index([userId, pipelineStage])
}

// Item do orçamento. Mesma forma do ReceivableItem (productId? | description? +
// scrapId?/listingId? + quantity + unitPrice snapshot) para a conversão copiar
// 1:1. Cascade do Budget; Restrict no Product (integridade histórica).
model BudgetItem {
  id          String   @id @default(cuid())
  budgetId    String
  productId   String? // NULL = item manual (texto livre)
  description String? // descrição do item manual; NULL p/ item cadastrado
  scrapId     String? // sucata de origem (override explícito)
  listingId   String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  budget  Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  scrap   Scrap?          @relation(fields: [scrapId], references: [id], onDelete: SetNull)
  listing ProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([productId])
  @@index([scrapId])
  @@index([listingId])
}

// Unidade (filial / loja física) — escopo por userId (= dataOwnerId), igual a
// Customer/Location. Soft-delete via `active` porque Receivable/Payable têm FK
// para cá; inativar preserva histórico e a semântica de "Sem unidade".
model Unidade {
  id        String   @id @default(cuid())
  userId    String
  name      String
  code      String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  receivables Receivable[]
  payables    Payable[]
  budgets     Budget[]

  @@unique([userId, code])
  @@index([userId, name])
}

model Scrap {
  id     String @id @default(cuid())
  userId String

  // Dados do veículo
  brand              String
  model              String
  year               String?
  version            String?
  color              String?
  plate              String?
  chassis            String?
  engineNumber       String?
  renavam            String?
  lot                String?
  deregistrationCert String?

  // Custo e pagamento
  cost          Decimal? @db.Decimal(10, 2)
  extraCosts    Decimal? @db.Decimal(10, 2) // transporte/guincho/taxas (Investimento = cost + extraCosts)
  paymentMethod String?

  // Localização (referência à entidade Location existente)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Dados fiscais / NF-e
  ncm             String?
  supplierCnpj    String?
  accessKey       String?
  issueDate       DateTime?
  entryDate       DateTime?
  nfeNumber       String?
  nfeProtocol     String?
  operationNature String?
  nfeSeries       String?
  fiscalModel     String?
  icmsValue       Decimal?  @db.Decimal(10, 2)
  icmsCtValue     Decimal?  @db.Decimal(10, 2)
  freightMode     String?
  issuePurpose    String?

  // Imagens/Anexos
  imageUrls String[] @default([])

  // Status e controle
  status          ScrapStatus     @default(AVAILABLE)
  logisticsStatus LogisticsStatus @default(IN_YARD)
  notes           String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user            User               @relation(fields: [userId], references: [id])
  products        Product[]
  statusEvents    ScrapStatusEvent[]
  // Vendas balcão (Conta a Receber) vinculadas diretamente a esta sucata —
  // inclui itens manuais (sem Product). onDelete SetNull no lado do item.
  receivableItems ReceivableItem[]
  // Itens de orçamento vinculados a esta sucata (mesma semântica do balcão).
  budgetItems     BudgetItem[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, logisticsStatus])
  @@index([plate])
  @@index([chassis])
}

// Histórico de transições de estágio logístico (diferencial F). Aditivo:
// gravado a cada transição; base para medir tempo por estágio e leilão→desmembrado.
model ScrapStatusEvent {
  id         String           @id @default(cuid())
  scrapId    String
  userId     String
  fromStatus LogisticsStatus?
  toStatus   LogisticsStatus
  createdAt  DateTime         @default(now())

  scrap Scrap @relation(fields: [scrapId], references: [id], onDelete: Cascade)

  @@index([scrapId, createdAt])
  @@index([userId, createdAt])
}

// =====================================================================
// Módulo Fiscal (NF-e)
// Additive-only: nenhuma alteração destrutiva em models existentes.
// =====================================================================

model CompanyFiscalConfig {
  id     String @id @default(cuid())
  userId String @unique

  cnpj               String
  razaoSocial        String
  nomeFantasia       String?
  inscricaoEstadual  String
  inscricaoMunicipal String?
  regimeTributario   String // SIMPLES | LUCRO_PRESUMIDO | LUCRO_REAL
  cnae               String?

  ambiente String @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO

  // Endereço fiscal
  cep          String?
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  municipio    String?
  codMunicipio String?
  uf           String?
  codPais      String? @default("1058")
  pais         String? @default("BRASIL")

  // Certificado A1
  certificadoPath      String?
  certificadoSenhaEnc  String?
  certificadoValidoAte DateTime?
  certificadoSubjectCN String? // CN do titular do A1 (ex.: "RAZAO:CNPJ") — exibição + reconferência do CNPJ

  // Provedor fiscal
  providerName  String? // FOCUS_NFE | ...
  providerToken String? // encriptado

  // Numeração — série padrão das NF-e desta empresa (o número é sequencial
  // automático por série/ambiente via NfeSequence). Default 1 preserva o
  // comportamento anterior (série hardcoded 1).
  serieNfe Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model NfeSequence {
  id            String   @id @default(cuid())
  userId        String
  ambiente      String // HOMOLOGACAO | PRODUCAO
  serie         Int
  proximoNumero Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@unique([userId, ambiente, serie])
  @@index([userId])
}

model NfeEmitida {
  id         String  @id @default(cuid())
  userId     String
  orderId    String?
  customerId String?

  // Identificação
  ambiente                  String // HOMOLOGACAO | PRODUCAO
  modelo                    String    @default("55")
  serie                     Int
  numero                    Int
  chaveAcesso               String?   @unique
  tipoOperacao              String // ENTRADA | SAIDA
  finalidade                String // NORMAL | COMPLEMENTAR | AJUSTE | DEVOLUCAO
  destinoOperacao           String // INTERNA | INTERESTADUAL | EXTERIOR
  naturezaOperacao          String
  indPresenca               String // 0..9
  intermediador             String?
  numeroPedido              String?
  // Observações nível-nota: vão ao <infAdic><infCpl> do XML e ao DANFE
  informacoesComplementares String?
  dataEmissao               DateTime?
  dataSaida                 DateTime?

  // Snapshots imutáveis pós-emissão
  destinatarioJson Json
  emitenteJson     Json?

  // Frete
  modalidadeFrete    String?
  transportadoraJson Json?

  // Totalizadores e blocos
  totaisJson             Json?
  notasReferenciadasJson Json?
  exportacaoJson         Json?
  pagamentosJson         Json?
  duplicatasJson         Json?
  volumesJson            Json?

  // Estado
  status               String // DRAFT | VALIDATING | SIGNING | SENDING | AUTHORIZED | REJECTED | CANCELLED | INUTILIZED
  protocoloAutorizacao String?
  dataAutorizacao      DateTime?
  motivoRejeicao       String?
  // cStat da última rejeição (SEFAZ). Distingue rejeição reaproveitável (número
  // não consumido) de denegada (110)/duplicidade (já consumido). null = legado.
  cStatRejeicao        Int?

  // Artefatos
  xmlOriginalPath   String?
  xmlAssinadoPath   String?
  xmlAutorizadoPath String?
  danfePdfPath      String?

  // Auditoria
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emittedByUserId String

  // Relações
  user     User          @relation(fields: [userId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  itens    NfeItem[]
  eventos  NfeAuditLog[]

  @@unique([userId, ambiente, serie, numero])
  @@index([userId, status])
  @@index([userId, dataEmissao])
  @@index([orderId])
  @@index([customerId])
}

model NfeItem {
  id            String   @id @default(cuid())
  nfeId         String
  productId     String?
  numero        Int
  codigo        String
  descricao     String
  ncm           String
  cfop          String
  cest          String?
  origem        Int
  unidade       String
  quantidade    Decimal  @db.Decimal(15, 4)
  valorUnitario Decimal  @db.Decimal(15, 4)
  valorTotal    Decimal  @db.Decimal(15, 2)
  desconto      Decimal? @db.Decimal(15, 2)
  observacoes   String?
  tributosJson  Json?

  nfe     NfeEmitida @relation(fields: [nfeId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([nfeId])
  @@index([productId])
}

model NfeAuditLog {
  id        String   @id @default(cuid())
  nfeId     String
  userId    String
  evento    String // CRIADA | EDITADA_DRAFT | VALIDADA | NUMERADA | ASSINADA | ENVIADA | AUTORIZADA | REJEITADA | CANCELADA | INUTILIZADA | XML_REENVIADO
  detalhes  Json?
  createdAt DateTime @default(now())

  nfe NfeEmitida @relation(fields: [nfeId], references: [id], onDelete: Cascade)

  @@index([nfeId])
  @@index([userId])
}

model NfeInutilizacao {
  id            String   @id @default(cuid())
  userId        String
  ambiente      String
  serie         Int
  numeroInicial Int
  numeroFinal   Int
  justificativa String
  protocolo     String?
  status        String // PENDENTE | ACEITA | REJEITADA
  respostaJson  Json?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// =============================================================================
// Caixa de mensagens (perguntas pré-venda do Mercado Livre).
// Snapshot local alimentado por webhook (topic="questions") e pull on-demand.
// Isolado dos fluxos de listing/order — apenas FK opcional para ProductListing
// para enriquecer a UI (nada quebra se a listing local não existir).
// =============================================================================

model MarketplaceQuestion {
  id                   String    @id @default(cuid())
  marketplaceAccountId String
  productListingId     String?
  externalQuestionId   String
  externalItemId       String
  externalBuyerId      String
  buyerNickname        String?
  text                 String    @db.Text
  status               String // UNANSWERED | ANSWERED | CLOSED_UNANSWERED | UNDER_REVIEW | BANNED | DELETED
  // Autor da mensagem em conversas de CHAT (Magalu): CUSTOMER | SELLER. Aditivo
  // e nullable: ML/Shopee (Q&A 1:1) deixam NULL e seguem usando `answer`. Quando
  // preenchido, a linha é UMA mensagem do chat (sem MarketplaceAnswer) e a UI
  // renderiza por authorType (SELLER à direita / CUSTOMER à esquerda).
  authorType           String?
  dateCreated          DateTime
  lastSyncedAt         DateTime  @default(now())
  readAt               DateTime?

  answer             MarketplaceAnswer?
  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id])
  productListing     ProductListing?    @relation(fields: [productListingId], references: [id])

  @@unique([marketplaceAccountId, externalQuestionId])
  @@index([marketplaceAccountId, status, dateCreated])
  @@index([marketplaceAccountId, externalItemId, dateCreated])
  @@index([marketplaceAccountId, readAt])
  @@index([productListingId])
}

model MarketplaceAnswer {
  id          String   @id @default(cuid())
  questionId  String   @unique
  text        String   @db.Text
  dateCreated DateTime
  status      String // ACTIVE | DELETED | DISABLED

  question MarketplaceQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
